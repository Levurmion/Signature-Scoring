{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["typescript", "unicorn", "import", "react", "react-hooks", "jsx-a11y", "oxc"],
  "jsPlugins": [{ "name": "local-functional", "specifier": "./tools/oxlint-no-throw.mjs" }],
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true,
    "browser": true
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "local-functional/no-throw-statements": "error",
    "import/no-cycle": "warn",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",

    "typescript/no-explicit-any": "warn",

    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/require-await": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/unbound-method": "error",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/restrict-template-expressions": "warn"
  },
  "ignorePatterns": [
    "dist",
    "build",
    ".vercel",
    "node_modules",
    "**/routeTree.gen.ts",
    "**/schema.d.ts",
    "api/src/db/types.ts",
    "api/openapi.json",
    "tools/**"
  ],
  "overrides": [
    {
      "files": ["**/*.config.{ts,js,mjs,cjs}", "**/vite.config.ts", "**/vitest.config.ts"],
      "rules": {
        "local-functional/no-throw-statements": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/scripts/**", "**/src/db/types.ts"],
      "rules": {
        "local-functional/no-throw-statements": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["**/components/ui/**"],
      "rules": {
        "local-functional/no-throw-statements": "off",
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
