# Supabase project URL and anon (public) API key, used by the browser client to start the Google
# OAuth flow and read the session. Find both under Project Settings > API in the Supabase
# dashboard. These are safe to expose to the browser (the anon key is rate/row-limited by RLS).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
