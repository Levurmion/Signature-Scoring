# openapi-typescript needs the real classic TypeScript compiler API (ts.factory) at runtime, but
# this repo's real TypeScript is 7 (the native compiler, which dropped that API). Rather than
# fight pnpm's peer resolution for a devDependency-only CLI tool, `frontend`'s `gen-types` script
# runs it via `pnpm dlx`, an isolated environment where it resolves its own compatible
# TypeScript. Keep remaining peer mismatches (e.g. from eslint-plugin-functional's TS tooling) as
# warnings, not hard failures.
auto-install-peers=true
strict-peer-dependencies=false

# Keep lockfile generation deterministic across contributors' npm config.
save-exact=true
