{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "frontend/src/index.css",
    "functions": ["clsx", "cn", "cva"]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.vercel/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "**/schema.d.ts",
    "api/src/db/types.ts",
    "api/openapi.json"
  ]
}
