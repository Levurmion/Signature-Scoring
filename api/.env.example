# Supabase Postgres connection string. Use the transaction pooler (port 6543) so the connection
# works from short-lived serverless/Fluid compute instances. Find this under
# Project Settings > Database > Connection string > Transaction pooler in the Supabase dashboard.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Local dev server port for `npm run dev -w api` (defaults to 8787 if unset).
PORT=8787
