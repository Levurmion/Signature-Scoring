# --agent
# Supabase Postgres connection string. Use the transaction pooler (port 6543) so the connection
# works from short-lived serverless/Fluid compute instances. Find this under
# Project Settings > Database > Connection string > Transaction pooler in the Supabase dashboard.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --agent
# Local dev server port for `pnpm --filter api dev` (defaults to 8787 if unset).
PORT=8787

# --agent
# Supabase project URL and anon key, used server-side to verify the bearer access token on
# authenticated routes via `supabase.auth.getUser(token)`. Same values as the frontend's
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (Project Settings > API in the Supabase dashboard).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
